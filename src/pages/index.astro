---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { projects, githubUser } from '../data/projects';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const featured = projects.filter((project) => project.featured);

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title="Ian McLaughlin">
  <section class="hero">
    <h1>Ian McLaughlin</h1>
    <p class="tagline">software engineer</p>
    <div class="links">
      <a href={`${base}about`}>about</a>
      <span class="sep">·</span>
      <a href="https://github.com/ianm199" target="_blank" rel="noopener noreferrer">github</a>
    </div>
  </section>

  <section class="work">
    <h2>selected work</h2>
    <div class="work-list">
      {featured.map((project) => (
        <a
          href={`https://github.com/${githubUser}/${project.repo}`}
          target="_blank"
          rel="noopener noreferrer"
          class="work-item"
        >
          <span class="work-title">{project.title}</span>
          <span class="work-blurb">{project.blurb}</span>
        </a>
      ))}
    </div>
    <a href={`${base}projects`} class="all-link">all projects →</a>
  </section>

  <section class="posts">
    <h2>recent</h2>
    {posts.length > 0 ? (
      <div class="posts-list">
        {posts.map((post, index) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.slug}
            tags={post.data.tags}
            index={index}
          />
        ))}
      </div>
    ) : (
      <p class="empty">nothing yet</p>
    )}

    <a href={`${base}blog`} class="all-link">all posts →</a>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: var(--space-3xl) 0;
    border-bottom: 1px solid var(--border);
  }

  .hero h1 {
    margin-bottom: var(--space-xs);
  }

  .tagline {
    color: var(--text-muted);
    margin-bottom: var(--space-lg);
  }

  .links {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .links a {
    color: var(--text-muted);
    border: none;
    transition: color 0.15s;
  }

  .links a:hover {
    color: var(--text-secondary);
  }

  .sep {
    color: var(--text-muted);
  }

  .work {
    padding: var(--space-xl) 0 0;
  }

  .work h2 {
    margin-bottom: var(--space-lg);
  }

  .work-list {
    display: flex;
    flex-direction: column;
  }

  .work-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-md) 0;
    border: none;
    border-bottom: 1px solid var(--border);
  }

  .work-item:last-child {
    border-bottom: none;
  }

  .work-title {
    color: var(--text-primary);
  }

  .work-item:hover .work-title {
    color: var(--text-secondary);
  }

  .work-blurb {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .posts {
    padding: var(--space-xl) 0;
  }

  .posts h2 {
    margin-bottom: var(--space-lg);
  }

  .posts-list {
    display: flex;
    flex-direction: column;
  }

  .empty {
    color: var(--text-muted);
  }

  .all-link {
    display: inline-block;
    margin-top: var(--space-lg);
    color: var(--text-muted);
    font-size: 0.9rem;
    border: none;
    transition: color 0.15s;
  }

  .all-link:hover {
    color: var(--text-secondary);
  }
</style>
