---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects, githubUser } from '../data/projects';

const response = await fetch(`https://api.github.com/users/${githubUser}/repos?per_page=100`);
if (!response.ok) {
  throw new Error(`GitHub API returned ${response.status} while fetching repos for ${githubUser}`);
}

const repos = await response.json();
const starsByRepo = new Map(repos.map((repo) => [repo.name, repo.stargazers_count]));

const enriched = projects.map((project) => {
  if (!starsByRepo.has(project.repo)) {
    throw new Error(`Repo "${project.repo}" not found in GitHub API response for ${githubUser}`);
  }
  return {
    ...project,
    stars: starsByRepo.get(project.repo),
    url: `https://github.com/${githubUser}/${project.repo}`,
  };
});

const featured = enriched.filter((project) => project.featured);
const others = enriched.filter((project) => !project.featured);
---

<BaseLayout title="Projects - Ian McLaughlin" description="Selected projects by Ian McLaughlin">
  <div class="projects-page">
    <h1>Projects</h1>
    <p class="tagline">A selection of things I've built. More on <a href={`https://github.com/${githubUser}`} target="_blank" rel="noopener noreferrer">github</a>.</p>

    <section class="section">
      <h2>selected</h2>
      <div class="projects-list">
        {featured.map((project) => (
          <ProjectCard
            title={project.title}
            blurb={project.blurb}
            language={project.language}
            stars={project.stars}
            url={project.url}
          />
        ))}
      </div>
    </section>

    <section class="section">
      <h2>more</h2>
      <div class="projects-list">
        {others.map((project) => (
          <ProjectCard
            title={project.title}
            blurb={project.blurb}
            language={project.language}
            stars={project.stars}
            url={project.url}
          />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .projects-page {
    padding: var(--space-xl) 0;
  }

  .projects-page h1 {
    margin-bottom: var(--space-sm);
  }

  .tagline {
    color: var(--text-muted);
    margin-bottom: var(--space-2xl);
  }

  .section {
    margin-bottom: var(--space-2xl);
  }

  .section h2 {
    margin-bottom: var(--space-md);
  }

  .projects-list {
    display: flex;
    flex-direction: column;
  }
</style>
